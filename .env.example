# ── 必填（沒有這些服務無法啟動）─────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/openclaw
JWT_SECRET=換成至少48字元的隨機字串
ENCRYPTION_KEY=換成64位元hex字串(openssl rand -hex 32)
PORT=4000
NODE_ENV=production

# ── Anthropic API（核心功能）─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ── URL 設定 ─────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.zeabur.app
BACKEND_URL=https://your-backend.zeabur.app
CORS_ORIGIN=https://your-frontend.zeabur.app

# ── Redis（選填，沒設定用記憶體快取）────────────────────────
REDIS_URL=redis://:PASSWORD@HOST:6379

# ── Email（選填）─────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=OpenClaw Console

# ── Stripe 付款（選填）──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_STARTER=price_xxxx
STRIPE_PRICE_PRO=price_xxxx

# ── LINE（選填，有 LINE 通道才需要）─────────────────────────
# 在 LINE Developer Console 取得
LINE_CHANNEL_ACCESS_TOKEN=在Secrets管理頁面設定，不是這裡

# ── Google OAuth（選填，Gmail/Calendar 整合）────────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ── 備份 S3/R2（選填）───────────────────────────────────────
R2_ACCESS_KEY=xxxx
R2_SECRET_KEY=xxxx
R2_BUCKET=openclaw-backups
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# ── OpenTelemetry（選填，監控用）────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway.grafana.net/otlp
